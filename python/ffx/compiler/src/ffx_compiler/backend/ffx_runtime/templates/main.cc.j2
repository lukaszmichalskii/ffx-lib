#include <ffx/ffx.h>

#include "model.h"

namespace ffx_runtime {

  int main() {
    ffx::framework::get_environment_info<Platform>();

    const auto& devices = ffx::devices<Platform>();
    Queue queue(devices[0]);
    Model model(queue);

    // host buffer allocations
{% for inp in inputs %}
    auto host_{{ inp.var }} = ffx::make_host_buffer<{{ inp.dtype }}[]>({{ inp.size_expr }});
{% endfor %}
{% for out in outputs %}
    auto host_{{ out.var }} = ffx::make_host_buffer<{{ out.dtype }}[]>({{ out.size_expr }});
{% endfor %}

    // device buffer allocations
{% for inp in inputs %}
    auto device_{{ inp.var }} = ffx::make_device_buffer<{{ inp.dtype }}[]>(queue, {{ inp.size_expr }});
{% endfor %}
{% for out in outputs %}
    auto device_{{ out.var }} = ffx::make_device_buffer<{{ out.dtype }}[]>(queue, {{ out.size_expr }});
{% endfor %}

    // initialize inputs and copy to device
{% for inp in inputs %}
    for (std::size_t index = 0; index < host_{{ inp.var }}.size(); index++) {
      host_{{ inp.var }}[index] = 1.0f;
    }
    alpaka::memcpy(queue, device_{{ inp.var }}, host_{{ inp.var }});
{% endfor %}

    // execute model inference with standardized I/O interface
    model.infer({{ infer_args | join(',\n        ') }});

    // copy outputs back to host
{% for out in outputs %}
    alpaka::memcpy(queue, host_{{ out.var }}, device_{{ out.var }});
{% endfor %}

    // synchronize scheduled workload
    alpaka::wait(queue);

{% for out in outputs %}
    for (std::size_t index = 0; index < host_{{ out.var }}.size(); index++) {
      std::print("{:.4f} ", host_{{ out.var }}[index]);
    }
    std::println();
{% endfor %}

    return 0;
  }

}  // namespace ffx_runtime

int main() { return ffx_runtime::main(); }