@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(POLICY CMP0135)
  cmake_policy(SET CMP0135 NEW)
endif()

if(POLICY CMP0167)
  cmake_policy(SET CMP0167 NEW)
endif()

find_package(Boost REQUIRED COMPONENTS atomic)

find_dependency(alpaka 2.1.1 QUIET)
if(NOT alpaka_FOUND)
  include(FetchContent)
  FetchContent_Declare(
    alpaka
    URL https://github.com/alpaka-group/alpaka/archive/refs/tags/2.1.1.tar.gz
    SYSTEM)
  FetchContent_MakeAvailable(alpaka)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ffxAddExecutable.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ffxTargets.cmake")

check_required_components(ffx)